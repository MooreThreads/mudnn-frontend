# Source this file from the mudnn-frontend checkout before building or testing:
#
#   source env.sh.example
#
# This file assumes an installed muDNN backend. Point the variables below at
# another prefix when the backend lives elsewhere:
#
#   export MUDNN_BACKEND_ROOT=/opt/musa

MUDNN_FRONTEND_ROOT="$(cd "$(dirname "${BASH_SOURCE:-$0}")" && pwd)"
_MUDNN_FRONTEND_DEFAULT_BACKEND="${MUDNN_BACKEND_ROOT:-/usr/local/musa}"

export MUDNN_BACKEND_ROOT="${MUDNN_BACKEND_ROOT:-${_MUDNN_FRONTEND_DEFAULT_BACKEND}}"
export MUDNN_BACKEND_INCLUDE="${MUDNN_BACKEND_INCLUDE:-${MUDNN_BACKEND_ROOT}/include}"
export MUDNN_BACKEND_LIB="${MUDNN_BACKEND_LIB:-${MUDNN_BACKEND_ROOT}/lib}"
# ctypes loads libmudnn.so from MUDNN_LIB, not from MUDNN_BACKEND_LIB.
export MUDNN_LIB="${MUDNN_LIB:-${MUDNN_BACKEND_LIB}}"

export MUDNN_FRONTEND_BUILD_DIR="${MUDNN_FRONTEND_BUILD_DIR:-${MUDNN_FRONTEND_ROOT}/build}"
export MUDNN_FRONTEND_TEST_BUILD_DIR="${MUDNN_FRONTEND_TEST_BUILD_DIR:-${MUDNN_BACKEND_ROOT}}"
export MUDNN_FRONTEND_FRAMEWORK_TEST_BUILD_DIR="${MUDNN_FRONTEND_FRAMEWORK_TEST_BUILD_DIR:-${MUDNN_FRONTEND_BUILD_DIR}/tests/cpp}"

export PYTHONDONTWRITEBYTECODE="${PYTHONDONTWRITEBYTECODE:-1}"
export PYTHONPATH="${MUDNN_FRONTEND_ROOT}/python:${MUDNN_FRONTEND_ROOT}/tests/python:${PYTHONPATH:-}"
export LD_LIBRARY_PATH="${MUDNN_BACKEND_LIB}:/usr/local/musa/lib:${LD_LIBRARY_PATH:-}"

echo "MUDNN_FRONTEND_ROOT=${MUDNN_FRONTEND_ROOT}"
echo "MUDNN_BACKEND_ROOT=${MUDNN_BACKEND_ROOT}"
echo "MUDNN_BACKEND_INCLUDE=${MUDNN_BACKEND_INCLUDE}"
echo "MUDNN_BACKEND_LIB=${MUDNN_BACKEND_LIB}"
echo "MUDNN_FRONTEND_BUILD_DIR=${MUDNN_FRONTEND_BUILD_DIR}"
