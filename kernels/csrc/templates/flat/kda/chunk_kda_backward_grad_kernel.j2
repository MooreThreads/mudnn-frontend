void {{ func_name }}_initial_state(
    ffi::TensorView q, ffi::TensorView k, ffi::TensorView g, ffi::TensorView beta,
    ffi::TensorView dO, ffi::TensorView dstate0,
    std::optional<ffi::TensorView> d_final_state,
    {% if safe_gate == "true" %}ffi::TensorView{% else %}std::optional<ffi::TensorView>{% endif %} A_log,
    {% if safe_gate == "true" %}ffi::TensorView{% else %}std::optional<ffi::TensorView>{% endif %} dt_bias,
    double scale, double lower_bound, std::optional<ffi::TensorView> cu_seqlens,
    std::optional<ffi::TensorView> d_states) {
  check_thd(q,{{ element_dtype }},"q");
  check_thd(k,{{ element_dtype }},"k");
  check_thd(g,{{ gate_element_dtype }},"g");
  check_thd(dO,{{ element_dtype }},"dO");
  CHECK_MUSA(beta);CHECK_DIM(3,beta);CHECK_INPUT_TYPE(beta,{{ beta_element_dtype }});
  CHECK_MUSA(dstate0);CHECK_DIM(4,dstate0);CHECK_INPUT_TYPE(dstate0,dl_float32);
  int H=int(q.size(2)),T=int(q.size(1));
  int nseq=cu_seqlens.has_value() ? int(cu_seqlens->size(0))-1 : int(q.size(0));
  TVM_FFI_ICHECK_EQ(dstate0.size(0),nseq);
  TVM_FFI_ICHECK_EQ(dstate0.size(1),H);
  TVM_FFI_ICHECK_EQ(dstate0.size(2),128);
  TVM_FFI_ICHECK_EQ(dstate0.size(3),128);
  Params p{};
  p.ptr_q=static_cast<Element const*>(q.data_ptr());
  p.ptr_k=static_cast<Element const*>(k.data_ptr());
  p.ptr_g=static_cast<ElementGate const*>(g.data_ptr());
  p.ptr_beta=static_cast<ElementBeta const*>(beta.data_ptr());
  p.ptr_dO=static_cast<Element const*>(dO.data_ptr());
  p.T=T;p.H=H;p.nseq=nseq;p.scale=float(scale);p.lower_bound=float(lower_bound);
  p.cu_seqlens=cu_seqlens.has_value() ? static_cast<CuSeqlensElement const*>(cu_seqlens->data_ptr()) : nullptr;
{% if safe_gate == "true" %}
  CHECK_MUSA(A_log);CHECK_INPUT_TYPE(A_log,dl_float32);
  CHECK_MUSA(dt_bias);CHECK_INPUT_TYPE(dt_bias,dl_float32);
  p.ptr_A_log=static_cast<float const*>(A_log.data_ptr());
  p.ptr_dt_bias=static_cast<float const*>(dt_bias.data_ptr());
{% endif %}
  if(d_final_state.has_value()) {
    auto dfs=*d_final_state;
    CHECK_MUSA(dfs);CHECK_INPUT_TYPE(dfs,dl_float32);
    TVM_FFI_ICHECK_EQ(d_final_state->numel(),dstate0.numel());
  }
  if(d_states.has_value()) {
    auto ds=*d_states;CHECK_MUSA(ds);CHECK_DIM(4,ds);CHECK_INPUT_TYPE(ds,{{ element_dtype }});
  }
  if(nseq==0) return;
  ffi::MUSADeviceGuard device_guard(q.device().device_id);
  musaStream_t stream=get_stream(q.device());
  mate::flat::kda::chunk_kda_initial_state_grad_kernel<Collective>
      <<<nseq*H*(128/4),128,0,stream>>>(
          p,static_cast<float*>(dstate0.data_ptr()),
          d_final_state.has_value() ? static_cast<float const*>(d_final_state->data_ptr()) : nullptr,
          d_states.has_value() ? static_cast<Element*>(d_states->data_ptr()) : nullptr);
  MATE_MUSA_RUNTIME_CHECK(musaGetLastError());
}
TVM_FFI_DLL_EXPORT_TYPED_FUNC({{ func_name }}_initial_state,{{ func_name }}_initial_state);
